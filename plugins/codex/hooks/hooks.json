{
  "description": "Use Codex's native allowance check and delegate below 10% remaining.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${PLUGIN_ROOT}/hooks/usage.sh\"",
            "timeout": 2,
            "statusMessage": "Loading Overflow"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${PLUGIN_ROOT}/hooks/usage.sh\"",
            "timeout": 2,
            "statusMessage": "Loading Overflow"
          }
        ]
      }
    ]
  }
}
