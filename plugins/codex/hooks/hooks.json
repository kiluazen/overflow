{
  "description": "Load the Codex native usage policy; manual Claude workflows need no usage hook.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CLAUDE_PLUGIN_ROOT:-}\" ]; then :; else /bin/sh \"${PLUGIN_ROOT}/hooks/usage.sh\"; fi",
            "timeout": 2,
            "statusMessage": "Loading Overflow"
          }
        ]
      }
    ]
  }
}
